# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=貼上你的LINE長期ChannelAccessToken
LINE_CHANNEL_SECRET=貼上你的LINEChannelSecret

# LIFF
LIFF_ID=貼上你的LIFF_ID
PUBLIC_BASE_URL=https://你的render網域.onrender.com

# DeepSeek API
DEEPSEEK_ENABLED=1
DEEPSEEK_API_KEY=貼上你的DeepSeekApiKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=220
DEEPSEEK_TIMEOUT=8

# 遊戲館/遊戲廳按鈕
VENUES=OB:歐博真人,DG:DG真人,MT:MT真人,T9:T9真人,SA:SA真人
DEFAULT_ROOMS=百家樂-中文廳,百家樂-亞洲廳,百家樂-極速廳,百家樂-保險廳,百家樂-VIP廳

# 本地資料保存
SESSION_DATA_FILE=sessions.json

# 規律模型權重：無觀望版，會每次都輸出莊/閒/和機率
MARKOV_WEIGHT=0.26
ROAD_WEIGHT=0.24
STREAK_WEIGHT=0.18
BALANCE_WEIGHT=0.12
RECENT_WEIGHT=0.10
TIE_WEIGHT=0.04
AI_BLEND=0.16

# 和局保護：建議預設不把和當主推薦，只顯示機率
ALLOW_TIE_RECOMMEND=0
TIE_SHRINK=0.35
TIE_MAX_PROB=0.18
TIE_RECOMMEND_MIN=0.165

# 冷啟動與AI觸發
MIN_HISTORY_FOR_AI=6
MIN_HISTORY_FOR_SIGNAL=4
MARKOV_ALPHA=2.4
MARKOV_FULL_SAMPLE=14

# Debug
DEBUG_PREDICTOR=0
DEBUG_AI_RESULT=0
